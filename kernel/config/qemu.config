# HWRun QEMU 运行级验证增量（叠加于 minimal.config）。
# 目标：串口控制台 + devtmpfs/misc 设备节点 + gzip 静态 initramfs 引导，
# 用于把 hwrun_core.ko insmod 进真实内核并做 ioctl 运行级验证。

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_MISC_DEVICES=y
CONFIG_RD_GZIP=y
CONFIG_PRINTK_TIME=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
